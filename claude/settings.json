{
  "alwaysThinkingEnabled": true,
  "autoMemoryEnabled": true,
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(npm test *)",
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(ls *)"
    ],
    "deny": [
      "Bash(rm -rf /)*",
      "Bash(chmod 777 *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
    ],
    "PreToolUse": [
    ]
  }
}
