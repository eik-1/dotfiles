{
  "ssh_connections": [
    {
      "host": "eik",
      "args": [],
      "projects": [
        {
          "paths": ["/home/eik/docker/refrakt/./"],
        },
      ],
    },
  ],
  "edit_predictions": {
    "provider": "codestral",
    "codestral": {
      "prediction_debounce": 1000,
      "api_url": "https://codestral.mistral.ai",
    },
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "agent": {
    "play_sound_when_agent_done": "when_hidden",
    "dock": "right",
    "default_model": {
      "speed": "standard",
      "provider": "openai-subscribed",
      "model": "gpt-6.1-sol",
      "enable_thinking": false,
      "effort": "high",
    },
    "threads_sidebar": {
      "position": "right",
    },
    "model_parameters": [],
  },
  "ui_font_family": "JetBrainsMono Nerd Font",
  "ui_font_size": 17,
  "ui_font_weight": 400,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 15,
  "agent_ui_font_size": 17,
  "agent_buffer_font_size": 17,
  "drag_and_drop_selection": {
    "enabled": false,
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
    "anthropic_retention": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "format_on_save": "on",
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
  },
  "base_keymap": "VSCode",
  "icon_theme": "Light Charmed Icons",
  "theme": "Catppuccin Latte",
  "theme_overrides": {
    "Catppuccin Latte": {
      "panel.focused_border": "#ccd0da",
      "syntax": {
        "comment": {
          "font_style": "italic",
        },
        "comment.doc": {
          "font_style": "italic",
        },
      },
    },
  },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_project_items": false,
    "show_branch_name": false,
  },
  "toolbar": {
    "quick_actions": false,
  },
  "project_panel": {
    "dock": "left",
    "default_width": 400,
    "hide_root": true,
    "auto_fold_dirs": false,
    "starts_open": true,
  },
  "file_finder": {
    "modal_max_width": "large",
  },
  "gutter": {
    "min_line_number_digits": 0,
    "runnables": false,
  },
  "inline_code_actions": false,
  "auto_update": false,
  "when_closing_with_no_tabs": "keep_window_open",
  "close_on_file_delete": true,
}
